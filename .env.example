# Copy this file to ".env" and edit it. The app runs fine without a .env at all
# -- everything below has a sensible default and email alerts stay switched off.

# ---------------------------------------------------------------- server ----
# 0.0.0.0 means "listen on every network interface", which is what lets other
# machines on the office LAN reach the app. Use 127.0.0.1 to make it local-only.
HOST=0.0.0.0
PORT=8000

# Where the SQLite database file lives. Relative paths are relative to the
# project folder. This single file IS the whole database -- back it up.
DB_PATH=stock.db

# ------------------------------------------------------- low-stock email ----
# Leave this false until the SMTP settings below are filled in and tested.
# When false, the app still flags low stock on the dashboard; it just does not
# try to send anything.
ALERTS_ENABLED=false

# Who gets told when something runs low (the manager). Comma-separate for more
# than one recipient.
ALERT_TO=manager@example.com
ALERT_FROM=it-stock@example.com

# Your mail server. For Microsoft 365 this is usually smtp.office365.com:587
# with TLS on; for Gmail, smtp.gmail.com:587 with an app password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=

# Don't re-send an alert for the same item more than once per this many hours,
# so a busy afternoon of handing out cables sends one email and not thirty.
ALERT_COOLDOWN_HOURS=24
